# ==============================================================================
# Server-side Environment Variables (Vercel Dashboard -> Settings -> Environment Variables)
# NEVER expose private keys with a VITE_ prefix.
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/recommend-outfit).
# Set this in Vercel Environment Variables (Production / Preview / Development).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model ID (defaults to gemini-3.1-flash-lite -> gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Optional canonical app URL (used for CORS origin checks / self-links).
# In Vercel, VERCEL_URL is automatically injected by the platform.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGIN: Optional comma-separated extra allowed origins for cross-origin API calls.
# ALLOWED_ORIGIN="https://example.com"

# ==============================================================================
# Client-side Public Environment Variables (Exposed to browser via import.meta.env)
# ==============================================================================

# VITE_API_BASE_URL: Optional API base URL override if frontend and API are hosted separately.
# Leave empty in standard Vercel / local deployments to use same-origin /api/* routes.
VITE_API_BASE_URL=""
